  },
  "devDependencies": {
    "@foldkit/vite-plugin": "^0.27.1",
    "@tailwindcss/vite": "^4.3.3",
    "happy-dom": "^21.0.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
