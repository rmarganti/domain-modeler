{
  "name": "domain-modeler",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-based visual domain model and ERD designer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "schema:generate": "vitest run --update src/domain/json-schema.test.ts",
    "check": "tsc --noEmit && oxlint && oxfmt --check && vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "~2.5.0",
    "@tauri-apps/plugin-dialog": "~2.8.3",
    "@tauri-apps/plugin-fs": "~2.7.1",
    "effect": "4.0.0",
    "foldkit": "0.168.0",
    "pluralize": "8.0.0"
  },
  "devDependencies": {
    "@foldkit/vite-plugin": "^0.27.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/pluralize": "0.0.33",
    "happy-dom": "^21.0.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0"
}
