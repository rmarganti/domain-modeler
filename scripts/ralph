#!/usr/bin/env bash

# ralph works through ready ishes one at a time with Claude Code until none
# remain. Each iteration picks the next ready, non-container ish, hands it to a
# fresh headless `claude` session, and checks that the ish ended `completed`
# with a new commit; anything else halts the loop for a human.
#
# Usage: scripts/ralph [--dry-run] [--once]
#   --dry-run  print the ish and prompt that would run, then exit
#   --once     run a single iteration
#
# Environment overrides:
#   RALPH_MODEL            default: claude-opus-5-5
#   RALPH_EFFORT           default: medium (low|medium|high|xhigh|max)
#   RALPH_PERMISSION_MODE  default: bypassPermissions (unattended; the agent
#                          runs shell commands, browsers, and git without asking)
#   RALPH_MAX_ITERATIONS   default: 10
#   RALPH_MAX_BUDGET_USD   optional per-iteration spend cap
#   RALPH_ALLOW_DIRTY=1    start even if the working tree has changes
#   TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID  optional finish/failure notices,
#                          same as ~/.local/bin/ralph

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

prompt_file="$repo_root/scripts/ralph.prompt.md"
log_dir="$repo_root/.ralph/logs"

model="${RALPH_MODEL:-claude-opus-5-5}"
effort="${RALPH_EFFORT:-medium}"
permission_mode="${RALPH_PERMISSION_MODE:-bypassPermissions}"
max_iterations="${RALPH_MAX_ITERATIONS:-10}"

dry_run=0
once=0
for arg in "$@"; do
    case "$arg" in
    --dry-run) dry_run=1 ;;
    --once) once=1 ;;
    -h | --help)
        sed -n '3,22p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    *)
        echo "Unknown argument: $arg" >&2
        exit 1
        ;;
    esac
done

for tool in claude ish jq git; do
    command -v "$tool" >/dev/null || {
        echo "ralph: '$tool' is not on PATH" >&2
        exit 1
    }
done

# NOTIFICATIONS

project_name=$(basename "$repo_root")
telegram_enabled=0
if [ -n "${TELEGRAM_BOT_TOKEN:-}" ] && [ -n "${TELEGRAM_CHAT_ID:-}" ]; then
    telegram_enabled=1
fi

send_telegram_message() {
    [ "$telegram_enabled" -eq 1 ] || return 0
    curl --silent --show-error --fail \
        -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
        -d "chat_id=${TELEGRAM_CHAT_ID}" \
        --data-urlencode "text=$1" \
        >/dev/null || echo "ralph: failed to send Telegram notice" >&2
}

iteration=0
start_time=$(date +%s)

notify_exit() {
    local exit_code=$?
    [ "$dry_run" -eq 1 ] && return
    local host elapsed
    host=$(hostname 2>/dev/null || echo "unknown-host")
    elapsed=$(($(date +%s) - start_time))
    if [ "$exit_code" -eq 0 ]; then
        [ "${TELEGRAM_NOTIFY_ON_SUCCESS:-1}" = "1" ] &&
            send_telegram_message "✅ ralph finished for ${project_name} on ${host}: ${iteration} iteration(s) in ${elapsed}s."
    else
        [ "${TELEGRAM_NOTIFY_ON_FAILURE:-1}" = "1" ] &&
            send_telegram_message "❌ ralph stopped for ${project_name} on ${host} (exit ${exit_code}) after ${iteration} iteration(s)."
    fi
    return 0
}
trap notify_exit EXIT

# HELPERS

# The next ready ish, skipping containers (epics and milestones are closed by
# their last child, never worked directly). Highest priority first, then oldest.
next_ready_ish() {
    ish list --ready --json --no-type epic --no-type milestone 2>/dev/null |
        jq -r '
            def rank: {"critical":0,"high":1,"normal":2,"low":3,"deferred":4}[.priority // "normal"] // 2;
            sort_by(rank, .created_at // .id) | .[0].id // empty'
}

ish_status() {
    ish list --json --all 2>/dev/null | jq -r --arg id "$1" '.[] | select(.id == $id) | .status'
}

render_prompt() {
    local template
    template=$(<"$prompt_file")
    printf '%s' "${template//\{\{ISH_ID\}\}/$1}"
}

# Condenses Claude's stream-json into readable progress lines.
pretty_stream() {
    jq -r --unbuffered '
        if .type == "assistant" then
            (.message.content[]? |
                if .type == "text" then .text
                elif .type == "tool_use" then
                    "  → \(.name) \((.input.command // .input.file_path // .input.pattern // .input.skill // "") | tostring | gsub("\n"; " ") | .[0:140])"
                else empty end)
        elif .type == "result" then
            "== \(.subtype) · turns \(.num_turns // "?") · $\(.total_cost_usd // 0 | tostring | .[0:6])"
        else empty end' 2>/dev/null || true
}

# MAIN LOOP

if [ "$dry_run" -eq 0 ] && [ "${RALPH_ALLOW_DIRTY:-0}" != "1" ] && [ -n "$(git status --porcelain)" ]; then
    echo "ralph: working tree has uncommitted changes; commit or stash them, or set RALPH_ALLOW_DIRTY=1" >&2
    exit 1
fi

mkdir -p "$log_dir"

while true; do
    ish_id=$(next_ready_ish)
    if [ -z "$ish_id" ]; then
        echo "ralph: no ready ishes. Done."
        exit 0
    fi

    if [ "$iteration" -ge "$max_iterations" ]; then
        echo "ralph: reached RALPH_MAX_ITERATIONS=${max_iterations}; next would be ${ish_id}" >&2
        exit 1
    fi
    iteration=$((iteration + 1))

    title=$(ish list --json --all | jq -r --arg id "$ish_id" '.[] | select(.id == $id) | .title')
    prompt=$(render_prompt "$ish_id")

    if [ "$dry_run" -eq 1 ]; then
        echo "Next ish: ${ish_id} — ${title}"
        echo "Command:  claude -p <prompt> --model ${model} --effort ${effort} --permission-mode ${permission_mode} --output-format stream-json --verbose${RALPH_MAX_BUDGET_USD:+ --max-budget-usd ${RALPH_MAX_BUDGET_USD}}"
        echo "----- prompt -----"
        echo "$prompt"
        exit 0
    fi

    head_before=$(git rev-parse HEAD)
    log_file="$log_dir/$(date +%Y%m%d-%H%M%S)-${ish_id}.jsonl"
    echo "=== Iteration ${iteration}: ${ish_id} — ${title} (log: ${log_file#"$repo_root"/}) ==="

    claude_args=(
        -p "$prompt"
        --model "$model"
        --effort "$effort"
        --permission-mode "$permission_mode"
        --output-format stream-json
        --verbose
    )
    [ -n "${RALPH_MAX_BUDGET_USD:-}" ] && claude_args+=(--max-budget-usd "$RALPH_MAX_BUDGET_USD")

    set +e
    claude "${claude_args[@]}" </dev/null | tee "$log_file" | pretty_stream
    claude_exit=${PIPESTATUS[0]}
    set -e

    if [ "$claude_exit" -ne 0 ]; then
        echo "ralph: claude exited with ${claude_exit} on ${ish_id}; see ${log_file}" >&2
        exit "$claude_exit"
    fi
    if jq -e 'select(.type == "result") | .is_error' "$log_file" >/dev/null 2>&1; then
        echo "ralph: claude reported an error result on ${ish_id}; see ${log_file}" >&2
        exit 1
    fi

    status=$(ish_status "$ish_id")
    if [ "$status" != "completed" ]; then
        echo "ralph: ${ish_id} ended as '${status:-unknown}', not completed. Read its Blocker notes: ish show ${ish_id}" >&2
        exit 1
    fi
    if [ "$(git rev-parse HEAD)" = "$head_before" ]; then
        echo "ralph: ${ish_id} was marked completed but no commit was made; check it by hand" >&2
        exit 1
    fi
    if [ -n "$(git status --porcelain)" ]; then
        echo "ralph: ${ish_id} left uncommitted changes; check it by hand" >&2
        exit 1
    fi

    echo "=== Iteration ${iteration} complete: $(git log -1 --format='%h %s') ==="
    [ "$once" -eq 1 ] && exit 0
done
